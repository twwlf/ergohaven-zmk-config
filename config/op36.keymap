#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 34 35 33>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mbase {
            display-name = "Base";
            bindings = <
  &kp Q         &kp W            &kp E          &kp R        &kp T                            &kp Y  &kp U        &kp I          &kp O        &kp P
  &hml LCTRL A  &hml LEFT_ALT S  &hml LSHIFT D  &hml LGUI F  &kp G                            &kp H  &hmr RGUI J  &hmr RSHIFT K  &hmr RALT L  &hmr RCTRL SEMI
  &kp Z         &kp X            &kp C          &kp V        &kp B                            &kp N  &kp M        &kp COMMA      &kp DOT      &kp FSLH
                                                &lt 5 ESC    &mo 1  &kp SPACE    &lt 3 ENTER  &mo 2  &lt 4 TAB
            >;
        };

        mnav {
            display-name = "Navigation";
            bindings = <
  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(SPACE)                       &kp HOME        &kp PG_DN   &kp PG_UP  &kp END          &kp INS
  &kp LCTRL  &kp LALT   &kp LSHFT  &kp LGUI   &kp ESC                             &kp LEFT_ARROW  &kp DOWN    &kp UP     &kp RIGHT_ARROW  &trans
  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(SPACE)                       &kp BACKSPACE   &kp DELETE  &trans     &trans           &trans
                                   &none      &trans         &trans    &kp ENTER  &kp LC(SPACE)   &kp TAB
            >;
        };

        mnum {
            bindings = <
  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT                        &trans  &kp LC(LS(TAB))  &kp LC(TAB)  &trans    &trans
  &kp SQT    &kp N4  &kp N5  &kp N6   &kp EQUAL                       &trans  &kp RGUI         &kp RSHFT    &kp RALT  &kp RCTRL
  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH                        &trans  &trans           &trans       &trans    &trans
                             &kp DOT  &kp N0     &kp MINUS    &trans  &trans  &trans
            >;
        };

        msym {
            bindings = <
  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK    &kp LPAR   &kp RIGHT_BRACE                               &trans  &trans    &trans     &trans    &trans
  &kp DQT         &kp DOLLAR     &kp PRCNT    &kp CARET  &kp PLUS                                      &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp TILDE       &kp EXCL       &kp AT_SIGN  &kp HASH   &kp BSLH                                      &trans  &trans    &trans     &trans    &trans
                                              &kp LPAR   &kp RPAR         &kp RU_UNDERSCORE    &trans  &trans  &trans
            >;
        };

        mfun {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN                    &trans  &trans    &trans     &trans    &trans
  &kp F11  &kp F4  &kp F5  &kp F6  &trans                             &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                    &trans  &trans    &trans     &trans    &trans
                           &trans  &kp SPACE        &trans    &trans  &trans  &trans
            >;
        };

        mmedia {
            bindings = <
  &out OUT_BLE  &out OUT_USB  &trans     &trans    &trans                        &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &kp LCTRL     &kp LALT      &kp LSHFT  &kp LGUI  &trans                        &kp C_PREV        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &trans
  &bootloader   &trans        &trans     &trans    &trans                        &trans            &trans        &trans        &trans        &bootloader
                                         &trans    &trans  &trans    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };
    };
};
