#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 34 35 33>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mbase {
            display-name = "Base";
            bindings = <
  &kp Q         &kp W            &kp E          &kp R        &kp T                            &kp Y  &kp U        &kp I          &kp O        &kp P
  &hml LCTRL A  &hml LEFT_ALT S  &hml LSHIFT D  &hml LGUI F  &kp G                            &kp H  &hmr RGUI J  &hmr RSHIFT K  &hmr RALT L  &hmr RCTRL SEMI
  &kp Z         &kp X            &kp C          &kp V        &kp B                            &kp N  &kp M        &kp COMMA      &kp DOT      &kp FSLH
                                                &lt 9 ESC    &mo 5  &kp SPACE    &lt 7 ENTER  &mo 6  &lt 8 TAB
            >;
        };

        base {
            bindings = <
  &kp Q  &kp W  &kp E  &kp R     &kp T                               &kp Y  &kp U      &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D  &kp F     &kp G                               &kp H  &kp J      &kp K      &kp L    &kp SEMI
  &kp Z  &kp X  &kp C  &kp V     &kp B                               &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH
                       &kp LGUI  &mo 2  &kp SPACE    &kp LEFT_SHIFT  &mo 3  &kp LCTRL
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1     &kp N2    &kp N3     &kp N4    &kp N5                              &kp N6          &kp N7         &kp N8  &kp N9           &kp N0
  &sk LCTRL  &sk LALT  &sk LSHFT  &sk LGUI  &kp ESC                             &kp LEFT_ARROW  &kp DOWN       &kp UP  &kp RIGHT_ARROW  &trans
  &none      &none     &none      &none     &kp LG(SPACE)                       &kp BACKSPACE   &kp PAGE_DOWN  &trans  &trans           &trans
                                  &mo 4     &trans         &trans    &kp ENTER  &kp LC(SPACE)   &kp TAB
            >;

            display-name = "Navigation";
        };

        sym {
            bindings = <
  &kp EXCL   &kp AT_SIGN  &kp HASH   &kp DOLLAR        &kp BACKSLASH                           &kp CARET  &kp AMPERSAND  &kp ASTRK      &kp LPAR          &kp RPAR
  &kp GRAVE  &kp PRCNT    &kp MINUS  &kp EQUAL         &kp LEFT_BRACKET                        &kp COLON  &sk RGUI       &sk LSHFT      &sk LALT          &sk RCTRL
  &kp TILDE  &none        &kp UNDER  &kp SINGLE_QUOTE  &kp RIGHT_BRACKET                       &kp SEMI   &kp PIPE       &kp LESS_THAN  &kp GREATER_THAN  &kp QMARK
                                     &kp TAB           &kp LC(SPACE)      &kp SPACE    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &none        &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp K_MUTE    &kp C_VOL_UP  &none
  &none        &kp F9  &kp F10  &kp F11  &kp F12                    &out OUT_USB  &kp C_PREV    &kp C_PP      &kp C_NEXT    &none
                                &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        mnav {
            display-name = "Navigation";
            bindings = <
  &none       &none      &none       &none        &kp INS                             &kp HOME        &kp PG_DN   &kp PG_UP  &kp END          &none
  &kp LCTRL   &kp LALT   &kp LSHFT   &kp LGUI     &kp ESC                             &kp LEFT_ARROW  &kp DOWN    &kp UP     &kp RIGHT_ARROW  &trans
  &kp K_UNDO  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp LG(SPACE)                       &kp BACKSPACE   &kp DELETE  &trans     &trans           &trans
                                     &none        &trans         &trans    &kp ENTER  &kp LC(SPACE)   &kp TAB
            >;
        };

        mnum {
            bindings = <
  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT                        &trans  &trans    &trans     &trans    &trans
  &kp SQT    &kp N4  &kp N5  &kp N6   &kp EQUAL                       &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH                        &trans  &trans    &trans     &trans    &trans
                             &kp DOT  &kp N0     &kp MINUS    &trans  &trans  &trans
            >;
        };

        msym {
            bindings = <
  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK    &kp LPAR   &kp RIGHT_BRACE                               &trans  &trans    &trans     &trans    &trans
  &kp DQT         &kp DOLLAR     &kp PRCNT    &kp CARET  &kp PLUS                                      &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp TILDE       &kp EXCL       &kp AT_SIGN  &kp HASH   &kp BSLH                                      &trans  &trans    &trans     &trans    &trans
                                              &kp LPAR   &kp RPAR         &kp RU_UNDERSCORE    &trans  &trans  &trans
            >;
        };

        mfun {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN                    &trans  &trans    &trans     &trans    &trans
  &kp F11  &kp F4  &kp F5  &kp F6  &trans                             &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                    &trans  &trans    &trans     &trans    &trans
                           &trans  &kp SPACE        &trans    &trans  &trans  &trans
            >;
        };

        mmedia {
            bindings = <
  &out OUT_BLE  &out OUT_USB  &trans     &trans    &trans                        &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &kp LCTRL     &kp LALT      &kp LSHFT  &kp LGUI  &trans                        &kp C_PREV        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &trans
  &bootloader   &trans        &trans     &trans    &trans                        &trans            &trans        &trans        &trans        &bootloader
                                         &trans    &trans  &trans    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };
    };
};
