#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
  &kp Q  &kp W  &kp E  &kp R  &kp T                          &kp Y      &kp U     &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D  &kp F  &kp G                          &kp H      &kp J     &kp K      &kp L    &kp SEMI
  &kp Z  &kp X  &kp C  &kp V  &kp B                          &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH
                       &mo 2  &mo 1  &kp SPACE    &kp RCTRL  &kp RSHFT  &kp RGUI
            >;
        };

        nav {
            display-name = "Navigation";
            bindings = <
  &none      &none     &none      &none     &kp LC(SPACE)                      &kp HOME        &kp PG_DN   &kp PG_UP  &kp END          &kp INS
  &sk LCTRL  &sk LALT  &sk LSHFT  &sk LGUI  &kp ESC                            &kp LEFT_ARROW  &kp DOWN    &kp UP     &kp RIGHT_ARROW  &trans
  &none      &none     &none      &none     &kp LG(SPACE)                      &kp BACKSPACE   &kp DELETE  &trans     &trans           &trans
                                  &mo 3     &trans         &mo 4    &kp ENTER  &kp LC(SPACE)   &kp TAB
            >;
        };

        rnum {
            bindings = <
  &none      &none     &none      &none     &kp LC(SPACE)                      &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT
  &sk LCTRL  &sk LALT  &sk LSHFT  &sk LGUI  &kp ESC                            &kp BSLH   &kp N4  &kp N5  &kp N6  &kp SQT
  &none      &none     &none      &none     &kp LG(SPACE)                      &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp EQUAL
                                  &none     &none          &none    &kp MINUS  &kp N9     &kp N0
            >;
        };

        media {
            bindings = <
  &out OUT_BLE  &out OUT_USB  &none  &none  &none                       &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &none         &none         &none  &none  &none                       &kp C_PREV        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none
  &bootloader   &none         &none  &none  &none                       &out OUT_TOG      &none         &none         &none         &bootloader
                                     &none  &none  &none    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        rfun {
            bindings = <
  &none      &none     &none      &none     &none                    &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN
  &sk LCTRL  &sk LALT  &sk LSHFT  &sk LGUI  &kp ESC                  &kp F11  &kp F4  &kp F5  &kp F6  &studio_unlock
  &none      &none     &none      &none     &none                    &kp F10  &kp F1  &kp F2  &kp F3  &none
                                  &none     &none    &none    &none  &none    &none
            >;
        };

        num {
            bindings = <
  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT                        &trans     &kp LC(LS(TAB))  &kp LC(TAB)  &trans    &trans
  &kp SQT    &kp N4  &kp N5  &kp N6  &kp EQUAL                       &kp COLON  &kp RGUI         &kp RSHFT    &kp RALT  &kp RCTRL
  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH                        &trans     &trans           &trans       &trans    &trans
                             &kp N9  &kp N0     &kp MINUS    &trans  &trans     &trans
            >;
        };

        sym {
            bindings = <
  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK    &kp LPAR   &kp RIGHT_BRACE                               &trans     &kp LC(LS(TAB))  &kp LC(TAB)    &trans            &trans
  &kp DQT         &kp DOLLAR     &kp PRCNT    &kp CARET  &kp PLUS                                      &kp COLON  &kp RGUI         &kp RSHFT      &kp RALT          &kp RCTRL
  &kp TILDE       &kp EXCL       &kp AT_SIGN  &kp HASH   &kp PIPE                                      &trans     &trans           &kp LESS_THAN  &kp GREATER_THAN  &kp QMARK
                                              &kp LPAR   &kp RPAR         &kp RU_UNDERSCORE    &trans  &trans     &trans
            >;
        };

        fun {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN                    &trans  &trans    &trans     &trans    &trans
  &kp F11  &kp F4  &kp F5  &kp F6  &studio_unlock                     &trans  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK                    &trans  &trans    &trans     &trans    &trans
                           &trans  &kp SPACE        &trans    &trans  &trans  &trans
            >;
        };
    };
};
